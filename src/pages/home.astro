---
import Navbar from '../components/Navbar.astro'
import ProfileCard from '../components/ProfileCard.astro'
import Footer from '../components/Footer.astro'
import SEO from '../components/SEO.astro'
import { createWebPageStructuredData } from '../utils/structuredData'

const siteURL = Astro.site || 'https://rizqiamanan.app'
const pageData = createWebPageStructuredData(
  siteURL,
  '/home',
  'Home - Rizqi Amanan Portfolio',
  'Homepage of Rizqi Amanan portfolio. Learn about skills, experience, and projects in web development and full stack development.'
)
---

<html lang="en">
  <head>
    <SEO
      title="Home - Rizqi Amanan Web Developer Portfolio"
      description="Welcome to Rizqi Amanan's portfolio. Discover skills in JavaScript, React, Node.js, Astro, and full stack development. View experience, projects, and contact information."
      canonicalURL="/home"
      keywords={[
        'rizqi amanan',
        'web developer portfolio',
        'home',
        'developer homepage',
        'surabaya developer',
      ]}
      structuredData={pageData}
    />
  </head>
  <body class="bg-gray-300">
    <Navbar />

    <main class="mt-20">
      <section class="py-10">
        <ProfileCard />
      </section>
    </main>
    <Footer />
  </body>
</html>
