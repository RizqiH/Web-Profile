---
import Navbar from '../components/Navbar.astro'
import MyProject from '../components/MyProject.astro'
import Footer from '../components/Footer.astro'
import SEO from '../components/SEO.astro'
import {
  createWebPageStructuredData,
  createPortfolioStructuredData,
} from '../utils/structuredData'

const siteURL = Astro.site || 'https://rizqiamanan.app'
const pageData = createWebPageStructuredData(
  siteURL,
  '/project',
  'Projects - Rizqi Amanan Portfolio',
  'View portfolio projects by Rizqi Amanan including Website Desa, Animal Mart, SK8Consign, Stocksim Pro, and more. Built with React, Next.js, Node.js, and modern web technologies.'
)
const portfolioData = createPortfolioStructuredData(siteURL)
---

<html lang="en">
  <head>
    <SEO
      title="Projects - Rizqi Amanan | Web Development Portfolio"
      description="Explore web development projects by Rizqi Amanan including e-commerce platforms, trading simulations, and community websites. Built with React, Next.js, Node.js, Express, TypeScript, and modern frameworks."
      canonicalURL="/project"
      keywords={[
        'rizqi amanan projects',
        'web development projects',
        'portfolio projects',
        'react projects',
        'nextjs projects',
        'full stack projects',
        'javascript projects',
        'website desa',
        'animal mart',
        'sk8consign',
        'stocksim pro',
      ]}
      structuredData={[pageData, portfolioData]}
    />
    <!-- GSAP and ScrollTrigger CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>
  </head>
  <body>
    <Navbar />
    <MyProject />
    <Footer />
  </body>
</html>
