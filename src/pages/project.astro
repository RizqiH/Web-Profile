---
import Navbar from '../components/Navbar.astro'
import MyProject from '../components/MyProject.astro'
import Footer from '../components/Footer.astro'
import SEO from '../components/SEO.astro'
import {
  createWebPageStructuredData,
  createPortfolioStructuredData,
} from '../utils/structuredData'

const siteURL = Astro.site || 'https://rizqiamanan.app'
const pageData = createWebPageStructuredData(
  siteURL,
  '/project',
  'Projects - Rizqi Amanan Portfolio',
  'View portfolio projects by Rizqi Amanan including Kontena AI, Trading Simulation, Face Verification, Animal Mart, and more. Built with Next.js, Go, Python, Laravel, and modern web technologies.'
)
const portfolioData = createPortfolioStructuredData(siteURL)
---

<html lang="en">
  <head>
    <SEO
      title="Projects - Rizqi Amanan | Web Development Portfolio"
      description="Explore web development projects by Rizqi Amanan including AI platforms, e-commerce, trading simulations, and community websites. Built with Next.js, Go, Python, Laravel, Express, TypeScript, and modern frameworks."
      canonicalURL="/project"
      keywords={[
        'rizqi amanan projects',
        'web development projects',
        'portfolio projects',
        'react projects',
        'nextjs projects',
        'full stack projects',
        'laravel projects',
        'go projects',
        'python projects',
        'kontena ai',
        'trading simulation',
      ]}
      structuredData={[pageData, portfolioData]}
    />
  </head>
  <body>
    <Navbar />
    <MyProject />
    <Footer />
  </body>
</html>
