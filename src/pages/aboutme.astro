---
import Navbar from '../components/Navbar.astro'
import AboutMe from '../components/AboutMe'
import Footer from '../components/Footer.astro'
import SEO from '../components/SEO.astro'
import { createWebPageStructuredData } from '../utils/structuredData'

const name = 'Muhammad Rizqi Amanan Habibulloh'
const bio =
  'Computer Science student specializing in cross-platform mobile development (Flutter/Dart) and native Android (Kotlin), as well as scalable backend services.'

const siteURL = Astro.site || 'https://rizqiamanan.app'
const pageData = createWebPageStructuredData(
  siteURL,
  '/aboutme',
  'About Me - Rizqi Amanan',
  'Learn about Muhammad Rizqi Amanan Habibulloh, Mobile Developer (Flutter/Kotlin) and Full Stack Web Developer specializing in Clean Architecture, BLoC, MVVM, and scalable backend services.'
)
---

<html lang="en">
  <head>
    <SEO
      title="About Me - Rizqi Amanan | Mobile & Full Stack Developer"
      description="About Muhammad Rizqi Amanan Habibulloh - Computer Science student at UPN Veteran East Java. Specializing in Flutter, Kotlin, Clean Architecture, BLoC, and Full Stack Web Development."
      canonicalURL="/aboutme"
      keywords={[
        'about rizqi amanan',
        'flutter developer',
        'android developer',
        'kotlin developer',
        'full stack developer bio',
        'upn veteran jawa timur',
        'clean architecture',
        'bloc pattern',
      ]}
      structuredData={pageData}
    />
  </head>
  <body class="bg-gray-300">
    <Navbar />

    <main class="mt-24">
      <section class="py-10">
        <AboutMe name={name} client:load />
      </section>
    </main>
    <Footer />
  </body>
</html>
