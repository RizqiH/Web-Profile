---
import Navbar from '../components/Navbar.astro'
import AboutMe from '../components/AboutMe'
import Footer from '../components/Footer.astro'
import SEO from '../components/SEO.astro'
import { createWebPageStructuredData } from '../utils/structuredData'

const name = 'Muhammad Rizqi Amanan Habibulah'
const bio =
  'I am a passionate software developer with a love for building scalable applications and exploring new technologies.'

const siteURL = Astro.site || 'https://rizqiamanan.app'
const pageData = createWebPageStructuredData(
  siteURL,
  '/aboutme',
  'About Me - Rizqi Amanan',
  'Learn about Muhammad Rizqi Amanan Habibullah, a passionate informatics student and web developer specializing in creative writing, UI/UX design, and full stack web development.'
)
---

<html lang="en">
  <head>
    <SEO
      title="About Me - Rizqi Amanan | Web Developer & Informatics Student"
      description="About Muhammad Rizqi Amanan Habibullah - Passionate informatics student at UPN Veteran East Java. Specializing in web development, UI/UX design, and creative writing. Learn about skills, experience, and background."
      canonicalURL="/aboutme"
      keywords={[
        'about rizqi amanan',
        'web developer bio',
        'informatics student',
        'upn veteran jawa timur',
        'creative writing',
        'ui ux designer',
        'full stack developer bio',
      ]}
      structuredData={pageData}
    />
  </head>
  <body class="bg-gray-300">
    <Navbar />

    <main class="mt-24">
      <section class="py-10">
        <AboutMe name={name} client:load />
      </section>
    </main>
    <Footer />
  </body>
</html>
