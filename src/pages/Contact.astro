---
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import ContactUs from '../components/ContactUs.astro'
import SEO from '../components/SEO.astro'
import { createWebPageStructuredData } from '../utils/structuredData'

const siteURL = Astro.site || 'https://rizqiamanan.app'
const pageData = createWebPageStructuredData(
  siteURL,
  '/Contact',
  'Contact - Rizqi Amanan',
  'Get in touch with Muhammad Rizqi Amanan Habibullah. Full Stack Web Developer based in Surabaya, Indonesia. Available for full-time onsite roles, contract work, and engineering collaborations.'
)
---

<html lang="en">
  <head>
    <SEO
      title="Contact - Rizqi Amanan | Full Stack Web Developer"
      description="Contact Muhammad Rizqi Amanan Habibullah. Full Stack Web Developer based in Surabaya, Indonesia. Email: rizkiamanan@gmail.com | Phone: +62 812 1781 0896"
      canonicalURL="/Contact"
      keywords={[
        'contact rizqi amanan',
        'hire web developer',
        'surabaya full stack developer',
        'laravel developer surabaya',
        'web developer contact',
        'rizkiamanan@gmail.com',
      ]}
      structuredData={pageData}
    />
  </head>
  <body class="bg-gray-300">
    <Navbar />
    <ContactUs />
    <Footer />
  </body>
</html>
