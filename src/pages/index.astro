---
import Navbar from '../components/Navbar.astro'
import ProfileCard from '../components/ProfileCard.astro'
import Footer from '../components/Footer.astro'
import SEO from '../components/SEO.astro'
import {
  createPersonStructuredData,
  createWebSiteStructuredData,
  createWebPageStructuredData,
} from '../utils/structuredData'

const siteURL = Astro.site || 'https://rizqiamanan.app'
const personData = createPersonStructuredData(siteURL)
const websiteData = createWebSiteStructuredData(siteURL)
const pageData = createWebPageStructuredData(
  siteURL,
  '/',
  'Rizqi Amanan - Mobile & Full Stack Developer Portfolio',
  'Portfolio website of Muhammad Rizqi Amanan Habibulloh, Mobile Developer (Flutter/Kotlin) and Full Stack Web Developer. Explore projects, skills, and experience.'
)
---

<html lang="en">
  <head>
    <SEO
      title="Rizqi Amanan - Mobile & Full Stack Developer Portfolio"
      description="Portfolio website of Muhammad Rizqi Amanan Habibulloh, Mobile Developer (Flutter/Kotlin) and Full Stack Web Developer specializing in Clean Architecture, BLoC, MVVM, Go, Python, and Node.js."
      canonicalURL="/"
      keywords={[
        'rizqi amanan',
        'mobile developer',
        'flutter developer',
        'kotlin developer',
        'full stack developer',
        'clean architecture',
        'bloc pattern',
        'android developer',
        'go developer',
        'surabaya developer',
        'indonesia developer',
      ]}
      structuredData={[personData, websiteData, pageData]}
    />
  </head>
  <body class="bg-gray-300">
    <Navbar />

    <main class="mt-20">
      <section class="py-10">
        <ProfileCard />
      </section>
    </main>
    <Footer />
  </body>
</html>
