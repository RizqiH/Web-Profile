---
import Navbar from '../components/Navbar.astro'
import ProfileCard from '../components/ProfileCard.astro'
import Footer from '../components/Footer.astro'
import SEO from '../components/SEO.astro'
import {
  createPersonStructuredData,
  createWebSiteStructuredData,
  createWebPageStructuredData,
} from '../utils/structuredData'

const siteURL = Astro.site || 'https://rizqiamanan.app'
const personData = createPersonStructuredData(siteURL)
const websiteData = createWebSiteStructuredData(siteURL)
const pageData = createWebPageStructuredData(
  siteURL,
  '/',
  'Rizqi Amanan - Web Developer Portfolio',
  'Portfolio website of Muhammad Rizqi Amanan Habibullah, a passionate web developer and full stack developer. Explore projects, skills, and experience in modern web technologies.'
)
---

<html lang="en">
  <head>
    <SEO
      title="Rizqi Amanan - Web Developer & Full Stack Developer Portfolio"
      description="Portfolio website of Muhammad Rizqi Amanan Habibullah, a passionate web developer and full stack developer specializing in React, Node.js, Astro, and modern web technologies. Explore projects, skills, and experience."
      canonicalURL="/"
      keywords={[
        'rizqi amanan',
        'web developer',
        'full stack developer',
        'portfolio',
        'javascript developer',
        'react developer',
        'nodejs developer',
        'astro developer',
        'surabaya developer',
        'indonesia developer',
        'software developer',
        'frontend developer',
        'backend developer',
      ]}
      structuredData={[personData, websiteData, pageData]}
    />
  </head>
  <body class="bg-gray-300">
    <Navbar />

    <main class="mt-20">
      <section class="py-10">
        <ProfileCard />
      </section>
    </main>
    <Footer />
  </body>
</html>
