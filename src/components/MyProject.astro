                      <!-- Title -->
                      <h3 class="text-xl sm:text-2xl md:text-[26px] font-bold tracking-tight text-white mb-1.5 drop-shadow-sm">
                        {project.title}
                      </h3>

                      <!-- Short Description / Value Pitch -->
                      <p class="text-xs sm:text-sm md:text-[14px] text-zinc-200 leading-relaxed">
                        {project.shortDescription}
