      <p class="font-bold text-[28px] max-md:text-[22px] text-black">Projects</p>
      <p class="mb-4 text-[16px] max-md:text-[14px] text-black">A glimpse of the stuffs I've built along the way!</p>
    </div>

    <div class="flex flex-col w-full mt-4">
      <!-- Projects Container - 60fps/120fps Hardware-Accelerated GSAP Stacking -->
      <div class="w-full min-h-[300vh] max-h-[450vh] max-lg:min-h-[340vh] projects-container mt-6 mb-64 pt-16">

        <!-- Absolute Positioned Cards Container -->
        <div class="absolute top-12 w-full min-h-[290vh] max-lg:max-h-[300vh] max-h-[440vh] max-w-4xl left-0 right-0 mx-auto z-30">
          <div class="max-w-full h-fit max-lg:px-2 cards-container">
            <ul id="cards" class="p-0 lg:p-4 max-w-full">
              {projectCards.map((project) => (
                <li class="card group" data-project-id={project.id}>
                  <!-- Background Image Layer (GPU layer with smooth hover) -->
