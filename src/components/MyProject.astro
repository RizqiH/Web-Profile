---

<section class="scroll-mt-24 bg-gray-300" id="work">
  <div class="px-6 sm:px-8 md:px-12 py-20 max-w-5xl mx-auto">
    <h2 class="text-xl tracking-tighter font-light text-black">
      Some of Minimal work.
    </h2>

    <div class="mt-10 mb-6">
      <p class="font-bold text-[28px] max-md:text-[22px] text-black">Projects</p>
      <p class="mb-4 text-[16px] max-md:text-[14px] text-black">A glimpse of the stuffs I've built along the way!</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
      {projectCards.map((project) => (
        <div
          class="project-card group bg-white rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 flex flex-col"
          data-project-id={project.id}
        >
          <div class="relative w-full overflow-hidden" style="aspect-ratio: 16/9;">
            <img
              src={project.bgImage}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <div class="flex flex-col flex-1 p-5 sm:p-6">
            <div class="flex items-center justify-between w-full gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-semibold tracking-wider text-gray-400">
                  {String(project.id).padStart(2, '0')} / {String(projectCards.length).padStart(2, '0')}
                </span>
                <span class="h-3 w-[1px] bg-gray-300"></span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-mono font-medium bg-gray-100 text-gray-600 border border-gray-200">
                  {project.role}
                </span>
              </div>
              <span class="text-xs font-mono text-gray-400">
                {project.duration}
              </span>
            </div>

            <h3 class="text-lg sm:text-xl font-bold tracking-tight text-gray-900 mb-1.5">
              {project.title}
            </h3>

            <p class="text-sm text-gray-500 leading-relaxed mb-3">
              {project.shortDescription}
            </p>

            <ul class="space-y-1 mb-4 hidden sm:block">
              {project.highlights.map((highlight) => (
                <li class="flex items-start gap-2 text-xs text-gray-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0 mt-1"></span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap items-center gap-1.5 mt-auto pt-3 border-t border-gray-100">
              {project.techStack.map((tech) => (
                <span class="inline-flex items-center text-[10px] sm:text-xs font-mono px-2 py-0.5 rounded-md bg-gray-100 text-gray-600 border border-gray-200">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-2.5 mt-4">
              {project.link !== '#' && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-semibold px-4 py-2 rounded-lg bg-gray-900 text-white hover:bg-gray-700 transition-all duration-150"
                >
                  {project.linkType === 'github' ? (
                    <>
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                      <span>GitHub Code</span>
                    </>
                  ) : (
                    <>
                      <span>Live Demo</span>
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </>
                  )}
                </a>
              )}

              <button
                class="read-more-btn inline-flex items-center gap-1 text-xs sm:text-[13px] font-medium px-3.5 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 border border-gray-200 text-gray-700 transition-all duration-150 cursor-pointer"
                data-project={project.id}
              >
                <span>Full Specs</span>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div id="project-modal" class="fixed inset-0 z-[120] px-4 py-8 items-center justify-center bg-black/80 hidden overflow-y-auto">
  <div class="bg-zinc-900 border border-zinc-700 text-white rounded-2xl p-6 sm:p-8 max-w-xl w-full relative shadow-2xl my-auto">
    <button id="close-modal" class="absolute top-4 right-4 text-zinc-400 hover:text-white text-2xl font-bold p-1 cursor-pointer transition-colors" aria-label="Close modal">
      &times;
    </button>

    <div class="flex items-center gap-2 mb-3">
      <span id="modal-role" class="px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-white/10 text-white border border-white/20"></span>
      <span id="modal-duration" class="text-xs font-mono text-zinc-400"></span>
    </div>

    <h3 id="modal-title" class="text-xl sm:text-2xl font-bold text-white mb-3"></h3>

    <div class="space-y-4 text-zinc-200 text-sm leading-relaxed">
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-zinc-400 font-semibold mb-1">Architecture and Implementation</h4>
        <p id="modal-description" class="whitespace-pre-line text-zinc-300"></p>
      </div>

      <div id="modal-highlights-container">
        <h4 class="text-xs font-mono uppercase tracking-wider text-zinc-400 font-semibold mb-2">Key Highlights</h4>
        <ul id="modal-highlights" class="space-y-1.5"></ul>
      </div>

      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-zinc-400 font-semibold mb-2">Technology Stack</h4>
        <div id="modal-tech" class="flex flex-wrap gap-1.5"></div>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-zinc-800 flex items-center justify-end gap-3">
      <a
        id="modal-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold px-4 py-2 rounded-lg bg-white text-black hover:bg-zinc-200 transition-all shadow cursor-pointer"
      >
        <span>Open Project</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      </a>
    </div>
  </div>
</div>

<script id="project-data-json" type="application/json" set:html={JSON.stringify(projectCards)}></script>

<style>
  .project-card {
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  #project-modal.hidden {
    display: none;
  }

  #project-modal:not(.hidden) {
    display: flex;
  }
</style>

<script>
  function initModal() {
    const modal = document.getElementById('project-modal');
    const closeBtn = document.getElementById('close-modal');
    const readMoreBtns = document.querySelectorAll('.read-more-btn');
    const modalTitle = document.getElementById('modal-title');
    const modalRole = document.getElementById('modal-role');
    const modalDuration = document.getElementById('modal-duration');
    const modalDescription = document.getElementById('modal-description');
    const modalHighlights = document.getElementById('modal-highlights');
    const modalTech = document.getElementById('modal-tech');
    const modalLink = document.getElementById('modal-link') as HTMLAnchorElement | null;

    let projectMap: Record<number, any> = {};
    const jsonElem = document.getElementById('project-data-json');
    if (jsonElem && jsonElem.textContent) {
      try {
        const rawList = JSON.parse(jsonElem.textContent);
        rawList.forEach((item: any) => {
          projectMap[item.id] = item;
        });
      } catch (e) {}
    }

    readMoreBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const projectIdStr = btn.getAttribute('data-project');
        if (!projectIdStr) return;
        const project = projectMap[parseInt(projectIdStr, 10)];
        if (!project) return;

        if (modalTitle) modalTitle.textContent = project.title;
        if (modalRole) modalRole.textContent = project.role;
        if (modalDuration) modalDuration.textContent = project.duration;
        if (modalDescription) modalDescription.textContent = project.description;

        if (modalHighlights) {
          modalHighlights.innerHTML = '';
          if (Array.isArray(project.highlights)) {
            project.highlights.forEach((h: string) => {
              const li = document.createElement('li');
              li.className = 'flex items-start gap-2 text-xs sm:text-sm text-zinc-300';
              li.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mt-1.5 shrink-0"></span><span>${h}</span>`;
              modalHighlights.appendChild(li);
            });
          }
        }

        if (modalTech) {
          modalTech.innerHTML = '';
          if (Array.isArray(project.techStack)) {
            project.techStack.forEach((t: string) => {
              const badge = document.createElement('span');
              badge.className = 'text-[11px] font-mono px-2.5 py-0.5 rounded bg-zinc-800 text-zinc-200 border border-zinc-700';
              badge.textContent = t;
              modalTech.appendChild(badge);
            });
          }
        }

        if (modalLink) {
          if (project.link && project.link !== '#') {
            modalLink.style.display = 'inline-flex';
            modalLink.href = project.link;
            modalLink.querySelector('span')!.textContent = project.linkType === 'github' ? 'View on GitHub' : 'Open Live Demo';
          } else {
            modalLink.style.display = 'none';
          }
        }

        modal?.classList.remove('hidden');
      });
    });

    const closeModal = () => modal?.classList.add('hidden');
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModal);
  } else {
    initModal();
  }
</script>
