                                  <span>GitHub Code</span>
                                </>
                              ) : (
                                <>
                                  <span>Live Demo</span>
                                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                </>
                              )}
                            </a>
                          )}
                          {project.link === '#' && (
                            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-zinc-800 text-zinc-300 border border-zinc-700">
                              <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                              <span>In Development</span>
                            </span>
                          )}
                        </div>

                        <!-- Read More / Full Specs Trigger -->
                        <button 
                          class="read-more-btn inline-flex items-center gap-1 text-xs sm:text-[13px] font-medium px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-lg bg-zinc-900/80 hover:bg-zinc-800 border border-white/20 text-white transition-all duration-150 cursor-pointer"
                          data-project={project.id}
                        >
