                          {project.role}
                        </span>
                      </div>
                      <span class="text-xs sm:text-sm font-mono text-zinc-300">
                        {project.duration}
                      </span>
                    </div>

                    <!-- Bottom Section: Title, Highlights, Tech, Actions -->
