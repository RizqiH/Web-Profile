---

<section class="min-h-screen bg-gray-300 pt-28 pb-24 px-6 sm:px-8 md:px-12" id="work">
  <div class="max-w-5xl mx-auto">
    <div class="mb-14">
      <h1 class="text-3xl sm:text-5xl tracking-tighter font-light text-black">
        Projects
      </h1>
      <p class="text-base sm:text-lg text-gray-700 font-light mt-3 max-w-2xl">
        Selected production platforms, full-stack systems, and engineering projects built with Clean Architecture, microservices, and modern frameworks.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projectCards.map((project, index) => (
        <article
          class="project-card group bg-white rounded-2xl border border-black/10 overflow-hidden flex flex-col transition-all duration-300 hover:border-black/25"
          data-project-id={project.id}
          style={`animation-delay: ${index * 0.06}s;`}
        >
          <div class="relative w-full overflow-hidden bg-gray-100 border-b border-black/5" style="aspect-ratio: 16/9;">
            <img
              src={project.bgImage}
              alt={project.title}
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="p-6 sm:p-7 flex flex-col flex-1">
            <div class="flex items-center justify-between text-xs font-mono text-gray-500 uppercase tracking-wider mb-2.5">
              <span>{project.role}</span>
              <span>{project.duration}</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-black mb-2">
              {project.title}
            </h2>

            <p class="text-sm text-gray-600 leading-relaxed mb-4">
              {project.shortDescription}
            </p>

            <div class="space-y-1.5 mb-5 hidden sm:block">
              {project.highlights.map((highlight) => (
                <div class="flex items-start text-xs text-gray-600">
                  <span class="text-gray-400 mr-2 select-none">&mdash;</span>
                  <span>{highlight}</span>
                </div>
              ))}
            </div>

            <div class="flex flex-wrap gap-1.5 mt-auto pt-4 border-t border-gray-100">
              {project.techStack.map((tech) => (
                <span class="text-[11px] font-mono px-2.5 py-0.5 rounded bg-gray-100 text-gray-700">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between pt-5 mt-2 border-t border-gray-100 text-sm">
              <div>
                {project.link !== '#' && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-black hover:underline underline-offset-4 inline-flex items-center gap-1"
                  >
                    <span>{project.linkType === 'github' ? 'Source Code' : 'Live Platform'}</span>
                    <span>&nearr;</span>
                  </a>
                )}
              </div>

              <button
                class="read-more-btn font-medium text-gray-600 hover:text-black hover:underline underline-offset-4 cursor-pointer"
                data-project={project.id}
              >
                Specifications &rarr;
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<div id="project-modal" class="fixed inset-0 z-[120] px-4 py-8 items-center justify-center bg-black/60 backdrop-blur-sm hidden overflow-y-auto">
  <div id="modal-card" class="bg-white border border-gray-200 text-black rounded-2xl p-6 sm:p-8 max-w-xl w-full relative my-auto shadow-2xl">
    <button id="close-modal" class="absolute top-4 right-4 text-gray-400 hover:text-black text-2xl font-light p-1 cursor-pointer transition-colors" aria-label="Close modal">
      &times;
    </button>

    <div class="flex items-center justify-between text-xs font-mono text-gray-500 uppercase tracking-wider mb-2 pr-6">
      <span id="modal-role"></span>
      <span id="modal-duration"></span>
    </div>

    <h2 id="modal-title" class="text-2xl font-bold tracking-tight text-black mb-4"></h2>

    <div class="space-y-5 text-sm text-gray-700 leading-relaxed">
      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-gray-400 mb-1.5">Architecture & Implementation</p>
        <p id="modal-description" class="whitespace-pre-line text-gray-800"></p>
      </div>

      <div id="modal-highlights-container">
        <p class="text-xs font-mono uppercase tracking-widest text-gray-400 mb-2">Key Engineering Highlights</p>
        <ul id="modal-highlights" class="space-y-1.5"></ul>
      </div>

      <div>
        <p class="text-xs font-mono uppercase tracking-widest text-gray-400 mb-2">Technologies</p>
        <div id="modal-tech" class="flex flex-wrap gap-1.5"></div>
      </div>
    </div>

    <div class="mt-8 pt-5 border-t border-gray-200 flex items-center justify-end">
      <a
        id="modal-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-6 py-2.5 bg-black text-white text-sm font-medium rounded-full hover:bg-gray-800 active:scale-95 transition-all cursor-pointer"
      >
        <span>Open Platform</span>
        <span>&nearr;</span>
      </a>
    </div>
  </div>
</div>

<script id="project-data-json" type="application/json" set:html={JSON.stringify(projectCards)}></script>

<style>
  @keyframes cardSlideIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-card {
    animation: cardSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  #project-modal.hidden {
    display: none;
  }

  #project-modal:not(.hidden) {
    display: flex;
    animation: modalFadeIn 0.15s ease-out;
  }

  #project-modal:not(.hidden) #modal-card {
    animation: modalScaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes modalScaleIn {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }
</style>

<script>
  function initModal() {
    const modal = document.getElementById('project-modal');
    const closeBtn = document.getElementById('close-modal');
    const readMoreBtns = document.querySelectorAll('.read-more-btn');
    const modalTitle = document.getElementById('modal-title');
    const modalRole = document.getElementById('modal-role');
    const modalDuration = document.getElementById('modal-duration');
    const modalDescription = document.getElementById('modal-description');
    const modalHighlights = document.getElementById('modal-highlights');
    const modalTech = document.getElementById('modal-tech');
    const modalLink = document.getElementById('modal-link') as HTMLAnchorElement | null;

    let projectMap: Record<number, any> = {};
    const jsonElem = document.getElementById('project-data-json');
    if (jsonElem && jsonElem.textContent) {
      try {
        const rawList = JSON.parse(jsonElem.textContent);
        rawList.forEach((item: any) => {
          projectMap[item.id] = item;
        });
      } catch (e) {}
    }

    readMoreBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const projectIdStr = btn.getAttribute('data-project');
        if (!projectIdStr) return;
        const project = projectMap[parseInt(projectIdStr, 10)];
        if (!project) return;

        if (modalTitle) modalTitle.textContent = project.title;
        if (modalRole) modalRole.textContent = project.role;
        if (modalDuration) modalDuration.textContent = project.duration;
        if (modalDescription) modalDescription.textContent = project.description;

        if (modalHighlights) {
          modalHighlights.innerHTML = '';
          if (Array.isArray(project.highlights)) {
            project.highlights.forEach((h: string) => {
              const li = document.createElement('li');
              li.className = 'flex items-start text-xs sm:text-sm text-gray-700';
              li.innerHTML = `<span class="text-gray-400 mr-2 select-none">&mdash;</span><span>${h}</span>`;
              modalHighlights.appendChild(li);
            });
          }
        }

        if (modalTech) {
          modalTech.innerHTML = '';
          if (Array.isArray(project.techStack)) {
            project.techStack.forEach((t: string) => {
              const badge = document.createElement('span');
              badge.className = 'text-[11px] font-mono px-2 py-0.5 rounded bg-gray-100 text-gray-700';
              badge.textContent = t;
              modalTech.appendChild(badge);
            });
          }
        }

        if (modalLink) {
          if (project.link && project.link !== '#') {
            modalLink.style.display = 'inline-flex';
            modalLink.href = project.link;
            modalLink.querySelector('span')!.textContent = project.linkType === 'github' ? 'View Source Code' : 'Open Platform';
          } else {
            modalLink.style.display = 'none';
          }
        }

        modal?.classList.remove('hidden');
      });
    });

    const closeModal = () => modal?.classList.add('hidden');
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModal);
  } else {
    initModal();
  }
</script>
