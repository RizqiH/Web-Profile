                    class="card-bg absolute inset-0 bg-cover bg-center"
                    style={`background-image: url('${project.bgImage}');`}
                  ></div>

                  <!-- High-Contrast Multi-Stop Scrim Gradient -->
                  <div class="card-scrim absolute inset-0 pointer-events-none"></div>

                  <!-- Subtle Border Accent -->
