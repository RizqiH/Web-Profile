                  <!-- Card Content -->
                  <div class="card-body relative flex flex-col justify-between h-full p-5 sm:p-7 md:p-8 z-10 text-white">
                    <!-- Top Row: Counter, Role Tag, Duration -->
                    <div class="flex items-center justify-between w-full gap-2">
                      <div class="flex items-center gap-2 sm:gap-3">
                        <span class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-zinc-300">
                          {String(project.id).padStart(2, '0')} / {String(projectCards.length).padStart(2, '0')}
