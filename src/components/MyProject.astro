<script>
  // Load GSAP Libraries
  async function loadGSAP() {
    if (window.gsap && window.ScrollTrigger) {
      return { gsap: window.gsap, ScrollTrigger: window.ScrollTrigger };
    }
    
    // Load GSAP Core
    await loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js');
    
    // Load ScrollTrigger Plugin
    await loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js');
    
    if (!window.gsap || !window.ScrollTrigger) {
      throw new Error('GSAP libraries not loaded properly');
    }
    
    // Configure ScrollTrigger - NO normalizeScroll so native 60-120fps trackpad scrolling is preserved!
    window.ScrollTrigger.config({ ignoreMobileResize: true, autoRefreshEvents: "visibilitychange,DOMContentLoaded,load" });
    
    // Register plugin
    window.gsap.registerPlugin(window.ScrollTrigger);
    
    return { gsap: window.gsap, ScrollTrigger: window.ScrollTrigger };
  }

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) {
        resolve();
        return;
      }
      
      const script = document.createElement('script');
      script.src = src;
      script.onload = () => resolve();
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  // Initialize Project Title Pin Animation
  function initProjectTitleAnimation(gsap: any, ScrollTrigger: any) {
    const projectTitle = document.querySelector('.projectTitle');
    
    if (projectTitle) {
      gsap.timeline({
        scrollTrigger: {
          trigger: projectTitle,
          start: "top 15%",
          end: "+=200px",    
          pin: true,
        },
      });
    }
  }

  // Initialize Card Stacking Animation (Optimized 60/120fps)
  function initCardStackingAnimation(gsap: any, ScrollTrigger: any) {
    const cards = document.querySelectorAll('.card');
    const cardsContainer = document.querySelector('.cards-container');
    const projectsContainer = document.querySelector('.projects-container');
    
    if (!cards.length || !cardsContainer) {
      return;
    }

    // Set initial positions with GPU layer promotion
    gsap.set(cards, {
      position: "absolute",
      top: 0,
      left: 0,
      force3D: true,
    });

    // Set initial z-index: First card on top, subsequent cards below
    cards.forEach((card: Element, index: number) => {
      const zIndexValue = cards.length - index;
      gsap.set(card, {
        zIndex: zIndexValue
      });
    });

    // Create stacking timeline with ultra-smooth 0.4s scrub for zero lag
    const stackTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: cardsContainer,
        start: "top 22%",
        end: "+=320%",
        scrub: 0.4, // Responsive and fluid without 1-second lag
        pin: true,
        pinSpacing: true,
        fastScrollEnd: true,
        onUpdate: (self: any) => {
          if (self.progress >= 0.96) {
            gsap.set(cardsContainer, {
              position: "fixed",
              top: "92px",
              left: "50%",
              transform: "translateX(-50%)",
              width: "100%",
              zIndex: 40,
            });

            if (projectsContainer) {
              gsap.set(projectsContainer, {
                zIndex: 0,
              });
            }
          } else {
            if (projectsContainer) {
              gsap.set(projectsContainer, {
                zIndex: 50,
              });
            }
          }
        },
        onLeaveBack: () => {
          gsap.set(cardsContainer, {
            clearProps: "all",
          });
        },
      },
    });

    // Hardware accelerated card upward exit
    stackTimeline.to(cards, {
      yPercent: -105,
      force3D: true,
      stagger: {
        amount: 1.6,
        from: "start"
      },
      ease: "none",
    });

    // Refresh ScrollTrigger
    ScrollTrigger.refresh();
  }

  // Initialize Modal functionality with parsed data
  function initModal() {
    const modal = document.getElementById('project-modal');
    const closeBtn = document.getElementById('close-modal');
    const readMoreBtns = document.querySelectorAll('.read-more-btn');
    const modalTitle = document.getElementById('modal-title');
    const modalRole = document.getElementById('modal-role');
    const modalDuration = document.getElementById('modal-duration');
    const modalDescription = document.getElementById('modal-description');
    const modalHighlights = document.getElementById('modal-highlights');
    const modalTech = document.getElementById('modal-tech');
    const modalLink = document.getElementById('modal-link') as HTMLAnchorElement | null;

    let projectMap: Record<number, any> = {};
    const jsonElem = document.getElementById('project-data-json');
    if (jsonElem && jsonElem.textContent) {
      try {
        const rawList = JSON.parse(jsonElem.textContent);
        rawList.forEach((item: any) => {
          projectMap[item.id] = item;
        });
      } catch (e) {
        console.error('Failed to parse project data:', e);
      }
    }

    readMoreBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const projectIdStr = btn.getAttribute('data-project');
        if (!projectIdStr) return;
        const project = projectMap[parseInt(projectIdStr, 10)];
        if (!project) return;

        if (modalTitle) modalTitle.textContent = project.title;
        if (modalRole) modalRole.textContent = project.role;
        if (modalDuration) modalDuration.textContent = project.duration;
        if (modalDescription) modalDescription.textContent = project.description;

        // Render Highlights
        if (modalHighlights) {
          modalHighlights.innerHTML = '';
          if (Array.isArray(project.highlights)) {
            project.highlights.forEach((h: string) => {
              const li = document.createElement('li');
              li.className = 'flex items-start gap-2 text-xs sm:text-sm text-zinc-300';
              li.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mt-1.5 shrink-0"></span><span>${h}</span>`;
              modalHighlights.appendChild(li);
            });
          }
        }

        // Render Tech Stack
        if (modalTech) {
          modalTech.innerHTML = '';
          if (Array.isArray(project.techStack)) {
            project.techStack.forEach((t: string) => {
              const badge = document.createElement('span');
              badge.className = 'text-[11px] font-mono px-2.5 py-0.5 rounded bg-zinc-800 text-zinc-200 border border-zinc-700';
              badge.textContent = t;
              modalTech.appendChild(badge);
            });
          }
        }

        // Render Action Button
        if (modalLink) {
          if (project.link && project.link !== '#') {
            modalLink.style.display = 'inline-flex';
            modalLink.href = project.link;
            modalLink.querySelector('span')!.textContent = project.linkType === 'github' ? 'View on GitHub' : 'Open Live Demo';
          } else {
            modalLink.style.display = 'none';
          }
        }

        modal?.classList.remove('hidden');
      });
    });

    const closeModal = () => modal?.classList.add('hidden');
    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  // Initialize on page load
  async function init() {
    try {
      const { gsap, ScrollTrigger } = await loadGSAP();
      await new Promise<void>(resolve => setTimeout(() => resolve(), 80));
      
      initProjectTitleAnimation(gsap, ScrollTrigger);
      setTimeout(() => {
        initCardStackingAnimation(gsap, ScrollTrigger);
      }, 150);
      
      initModal();
    } catch (error) {
      console.error('GSAP Init error:', error);
      initModal();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  window.addEventListener('beforeunload', () => {
    if (window.ScrollTrigger && window.ScrollTrigger.getAll) {
      window.ScrollTrigger.getAll().forEach((t: any) => t.kill());
    }
  });
</script>