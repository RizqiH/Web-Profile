---
interface Props {
  title: string
  description: string
  canonicalURL?: string
  ogImage?: string
  ogType?: string
  twitterCard?: string
  keywords?: string[]
  author?: string
  publishedTime?: string
  modifiedTime?: string
  structuredData?: object
}

const {
  title,
  description,
  canonicalURL,
  ogImage = '/assets/images/fotoku.jpg',
  ogType = 'website',
  twitterCard = 'summary_large_image',
  keywords = ['web developer', 'full stack developer', 'portfolio', 'rizqi amanan', 'software developer', 'javascript', 'react', 'nodejs', 'astro'],
  author = 'Muhammad Rizqi Amanan Habibullah',
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props

const siteURL = Astro.site || 'https://rizqiamanan.app'
const fullTitle = title.includes('Rizqi') || title.includes('Profile') ? title : `${title} | Rizqi Amanan - Web Developer Portfolio`
const fullCanonicalURL = canonicalURL ? new URL(canonicalURL, siteURL).href : new URL(Astro.url.pathname, siteURL).href
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteURL).href
const keywordsString = keywords.join(', ')
---

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="keywords" content={keywordsString} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow" />
<meta name="language" content="English" />
<meta name="revisit-after" content="7 days" />

<!-- Canonical URL -->
<link rel="canonical" href={fullCanonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={fullCanonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Rizqi Amanan - Web Developer Portfolio" />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:url" content={fullCanonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:creator" content="@rizqiamanan" />
<meta name="twitter:site" content="@rizqiamanan" />

<!-- Additional Meta Tags -->
<meta name="theme-color" content="#d1d5db" />
<meta name="msapplication-TileColor" content="#d1d5db" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.svg" />

<!-- Preconnect for Performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

<!-- Structured Data (JSON-LD) -->
{structuredData && (
  Array.isArray(structuredData) ? (
    structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))
  ) : (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )
)}

