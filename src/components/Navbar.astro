---
const links = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/aboutme' },
  { name: 'Projects', href: '/project' },
  { name: 'Contact', href: '/Contact' },
]
---

<nav class="fixed top-4 inset-x-0 z-[100]">
  <div class="max-w-2xl mx-auto px-4 sm:px-8">
    <div class="w-full mx-auto">
      <div
        class="relative flex items-center justify-between w-full p-3 mx-auto bg-white/90 ring-1 uppercase ring-zinc-200 backdrop-blur-xl rounded-xl md:rounded-full"
      >
        <a
          href="/"
          class="text-gray-600 hover:text-black gap-4 items-center tracking-tighter inline-flex font-bold text-xl transition-colors duration-300"
        >
          Rizqi
        </a>

        <div class="md:hidden ml-auto flex items-center">
          <button
            id="menu-btn"
            aria-label="Toggle navigation"
            class="w-9 h-9 flex flex-col justify-center items-center gap-1.5 focus:outline-none p-1 rounded-lg hover:bg-gray-100 transition-colors"
          >
            <span
              id="bar-top"
              class="w-5 h-0.5 bg-gray-800 rounded-full transition-all duration-300 ease-in-out origin-center"
            ></span>
            <span
              id="bar-mid"
              class="w-5 h-0.5 bg-gray-800 rounded-full transition-all duration-300 ease-in-out origin-center"
            ></span>
            <span
              id="bar-bot"
              class="w-5 h-0.5 bg-gray-800 rounded-full transition-all duration-300 ease-in-out origin-center"
            ></span>
          </button>
        </div>

        <ul
          class="hidden md:space-y-0 md:ml-auto items-center md:inline-flex justify-center text-center md:text-left gap-3 md:block"
        >
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-500 hover:text-black transition-colors duration-300 px-3 py-1 rounded-full hover:bg-gray-100/60"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        id="menu"
        class="md:hidden mt-2 overflow-hidden bg-white/95 backdrop-blur-xl rounded-2xl ring-1 ring-zinc-200 transition-all duration-300 ease-out max-h-0 opacity-0 -translate-y-2 pointer-events-none"
      >
        <ul class="flex flex-col p-2 space-y-1">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="menu-link block py-2.5 px-4 rounded-xl text-center text-sm font-medium tracking-wide text-gray-700 hover:text-black hover:bg-gray-100/80 active:bg-gray-200 transition-all duration-200"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById('menu-btn')!
  const menu = document.getElementById('menu')!
  const barTop = document.getElementById('bar-top')!
  const barMid = document.getElementById('bar-mid')!
  const barBot = document.getElementById('bar-bot')!
  const menuLinks = document.querySelectorAll('.menu-link')
  let menuOpen = false

  function toggleMenu(open?: boolean) {
    menuOpen = typeof open === 'boolean' ? open : !menuOpen

    if (menuOpen) {
      menu.classList.remove('max-h-0', 'opacity-0', '-translate-y-2', 'pointer-events-none')
      menu.classList.add('max-h-80', 'opacity-100', 'translate-y-0', 'pointer-events-auto')
      barTop.classList.add('rotate-45', 'translate-y-2')
      barMid.classList.add('opacity-0', 'scale-0')
      barBot.classList.add('-rotate-45', '-translate-y-2')
    } else {
      menu.classList.remove('max-h-80', 'opacity-100', 'translate-y-0', 'pointer-events-auto')
      menu.classList.add('max-h-0', 'opacity-0', '-translate-y-2', 'pointer-events-none')
      barTop.classList.remove('rotate-45', 'translate-y-2')
      barMid.classList.remove('opacity-0', 'scale-0')
      barBot.classList.remove('-rotate-45', '-translate-y-2')
    }
  }

  menuBtn.addEventListener('click', (e) => {
    e.stopPropagation()
    toggleMenu()
  })

  menuLinks.forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false))
  })

  document.addEventListener('click', (e) => {
    if (menuOpen && !menu.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
      toggleMenu(false)
    }
  })
</script>
