<section class="min-h-screen bg-gray-300 pt-28 pb-24 px-6 sm:px-8 md:px-12">
  <div class="max-w-4xl mx-auto">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-5xl tracking-tighter font-light text-black">
        Contact
      </h1>
      <p class="text-base sm:text-lg text-gray-700 font-light mt-3 max-w-xl">
        Have a question, an opportunity, or want to build something together? Drop a message below or reach out directly.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 items-start">
      <div class="md:col-span-2 flex flex-col space-y-8">
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-gray-500 mb-1">Email</p>
          <a
            href="mailto:rizkiamanan@gmail.com"
            class="text-base sm:text-lg font-medium text-black hover:underline underline-offset-4 break-all"
          >
            rizkiamanan@gmail.com
          </a>
        </div>

        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-gray-500 mb-1">Phone / WhatsApp</p>
          <a
            href="tel:+6281217810896"
            class="text-base sm:text-lg font-medium text-black hover:underline underline-offset-4"
          >
            +62 812 1781 0896
          </a>
        </div>

        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-gray-500 mb-1">Location</p>
          <p class="text-base sm:text-lg font-medium text-black">
            Surabaya, Indonesia
          </p>
        </div>

        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-gray-500 mb-2">Connect</p>
          <div class="flex flex-col space-y-2">
            <a
              href="https://linkedin.com/in/rizki-amanan"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-gray-800 hover:text-black hover:underline underline-offset-4"
            >
              LinkedIn &rarr;
            </a>
            <a
              href="https://github.com/RizqiH"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-gray-800 hover:text-black hover:underline underline-offset-4"
            >
              GitHub &rarr;
            </a>
          </div>
        </div>
      </div>

      <div class="md:col-span-3">
        <form
          action="https://formspree.io/f/mzzbgqeb"
          method="POST"
          class="space-y-6"
        >
          <div>
            <label for="name" class="block text-xs font-mono uppercase tracking-widest text-gray-600 mb-2">
              Name
            </label>
            <input
              id="name"
              type="text"
              name="name"
              required
              class="w-full bg-white/60 border border-gray-400/60 rounded-lg px-4 py-3 text-black text-sm focus:outline-none focus:bg-white focus:border-black transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono uppercase tracking-widest text-gray-600 mb-2">
              Email
            </label>
            <input
              id="email"
              type="email"
              name="email"
              required
              class="w-full bg-white/60 border border-gray-400/60 rounded-lg px-4 py-3 text-black text-sm focus:outline-none focus:bg-white focus:border-black transition-colors"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-mono uppercase tracking-widest text-gray-600 mb-2">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full bg-white/60 border border-gray-400/60 rounded-lg px-4 py-3 text-black text-sm focus:outline-none focus:bg-white focus:border-black transition-colors resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            class="px-8 py-3 bg-black text-white text-sm font-medium rounded-full hover:bg-gray-800 active:scale-95 transition-all cursor-pointer"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
